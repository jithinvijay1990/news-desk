{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "news-desk",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "triggers": {
    // Every five minutes. Overnight IST the handler itself drops to every 15
    // minutes: KV allows 1,000 writes a day on the free plan, and 5-minute
    // polling around the clock would overrun it. A second cron expression would
    // express that more clearly, but the account is at the free plan's 5-trigger
    // cap, so the night schedule lives in code instead.
    // Only one cron: the second ingest batch is chained through SELF instead.
    "crons": ["*/5 * * * *"]
  },
  // Self-binding: each batch of feeds needs its own subrequest budget (50 per
  // invocation on the free plan), and a service-binding call starts a fresh one.
  "services": [
    { "binding": "SELF", "service": "news-desk" }
  ],
  "kv_namespaces": [
    {
      "binding": "NEWS",
      "id": "d4cfb328b8fc49628e9cc585b064ff0c"
    }
  ]
}
